# Copy this file to .env and adjust values for your environment.
# python-dotenv will automatically load .env when present.

APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-string-in-production

# PostgreSQL connection string used in production. Leave unset in development
# to fall back to a local SQLite database under instance/.
DATABASE_URL=postgresql://bhel_user:bhel_password@localhost:5432/bhel_pms

PORT=5000
